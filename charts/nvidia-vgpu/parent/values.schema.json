{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "hami": {
            "type": "object",
            "properties": {
                "schedulerName": {
                    "type": "string",
                    "default": "hami-scheduler"
                },
                "devicePlugin": {
                    "type": "object",
                    "properties": {
                        "deviceCoreScaling": {
                            "type": "number"
                        },
                        "deviceMemoryScaling": {
                            "type": "number"
                        },
                        "deviceSplitCount": {
                            "type": "integer"
                        }
                    }
                },
                "prometheus": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Create ServiceMonitors for HAMi metrics. Ensure insight-agent is installed and running before enabling this feature."
                        }
                    }
                }
            },
            "description": "After installation, the original GPU node remains unchanged. Newly added GPU nodes default to use full GPU. If you need to switch to vGPU, please go to the appropriate node to make the switch."
        }
    }
}
