          "refId": "A",
          "expr": "sum by (le) (rate(rdma_flow_send_bytes_bucket{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval]))",
