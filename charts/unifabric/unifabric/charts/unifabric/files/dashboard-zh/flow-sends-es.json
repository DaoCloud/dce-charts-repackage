  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "src_pod",
        "label": "源 Pod",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "unifabric-elasticsearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"src_pod_name\", \"size\": 200}",
        "refresh": 2,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
