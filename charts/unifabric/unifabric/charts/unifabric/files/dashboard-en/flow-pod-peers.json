{
  "uid": "unifabric-flow-pod-peers",
  "title": "Unifabric / RDMA Flow",
  "description": "Pick a workload and one of its Pods to see the RDMA payload traffic that Pod sends to each peer Pod.",
  "tags": [
    "unifabric",
    "rdma",
    "ebpf",
    "flow",
    "pod"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "namespace",
        "label": "Workload namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(rdma_flow_bytes_total, src_pod_top_owner_namespace)",
        "query": {
          "query": "label_values(rdma_flow_bytes_total, src_pod_top_owner_namespace)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "kind",
        "label": "Workload kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\"}, src_pod_top_owner_kind)",
        "query": {
          "query": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\"}, src_pod_top_owner_kind)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "workload",
        "label": "Workload",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\"}, src_pod_top_owner_name)",
        "query": {
          "query": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\"}, src_pod_top_owner_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\"}, src_pod_name)",
        "query": {
          "query": "label_values(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\"}, src_pod_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "options": [],
        "current": {},
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 47,
      "type": "row",
      "title": "Pod peer traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Send rate",
      "description": "Payload rate the selected Pod currently sends to all peers.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "WR rate",
      "description": "Work requests the selected Pod currently posts per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(rdma_flow_wrs_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval]))",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Active QPs",
      "description": "Queue pair entries attributed to the selected Pod in the last report.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rdma_flow_qps{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"})",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Active peer Pods",
      "description": "Peer Pods currently receiving traffic.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count(\n  sum by (dst_pod_namespace, dst_pod_name) (\n    rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n  ) > 0\n)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Sent in time range",
      "description": "Payload bytes sent to all peers within the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(increase(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__range]))",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "valueSize": 28
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Send rate by peer Pod",
      "description": "Payload rate from the selected Pod to each peer Pod, legend is the peer namespace/name.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (dst_pod_namespace, dst_pod_name) (\n  rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n)",
          "legendFormat": "{{dst_pod_namespace}}/{{dst_pod_name}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Send rate by peer workload",
      "description": "Traffic to Pods of the same peer workload merged into one series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (dst_pod_top_owner_kind, dst_pod_top_owner_namespace, dst_pod_top_owner_name) (\n  rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n)",
          "legendFormat": "{{dst_pod_top_owner_kind}} {{dst_pod_top_owner_namespace}}/{{dst_pod_top_owner_name}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "bargauge",
      "title": "Bytes sent in time range by peer Pod",
      "description": "Payload bytes sent to each peer Pod within the selected time range, descending.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sort_desc(sum by (dst_pod_namespace, dst_pod_name) (\n  increase(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__range])\n))",
          "legendFormat": "{{dst_pod_namespace}}/{{dst_pod_name}}",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0,
          "displayName": "${__series.name}"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "sizing": "manual",
        "minVizHeight": 18,
        "maxVizHeight": 28,
        "minVizWidth": 8,
        "text": {
          "titleSize": 13,
          "valueSize": 14
        },
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      },
      "id": 8
    },
    {
      "type": "table",
      "title": "Peer details",
      "description": "One row per peer Pod and device pair with the peer workload, local and peer devices, current rate, total bytes and QP count.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (dst_pod_namespace, dst_pod_name, dst_pod_top_owner_kind, dst_pod_top_owner_namespace, dst_pod_top_owner_name, src_device, dst_device) (\n  rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum by (dst_pod_namespace, dst_pod_name, dst_pod_top_owner_kind, dst_pod_top_owner_namespace, dst_pod_top_owner_name, src_device, dst_device) (\n  rate(rdma_flow_wrs_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "sum by (dst_pod_namespace, dst_pod_name, dst_pod_top_owner_kind, dst_pod_top_owner_namespace, dst_pod_top_owner_name, src_device, dst_device) (\n  increase(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__range])\n)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "D",
          "expr": "sum by (dst_pod_namespace, dst_pod_name, dst_pod_top_owner_kind, dst_pod_top_owner_namespace, dst_pod_top_owner_name, src_device, dst_device) (\n  rdma_flow_qps{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}\n)",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "dst_pod_namespace": 0,
              "dst_pod_name": 1,
              "dst_pod_top_owner_kind": 2,
              "dst_pod_top_owner_namespace": 3,
              "dst_pod_top_owner_name": 4,
              "src_device": 5,
              "dst_device": 6,
              "Value #A": 7,
              "Value #B": 8,
              "Value #C": 9,
              "Value #D": 10
            },
            "renameByName": {
              "dst_pod_namespace": "Peer namespace",
              "dst_pod_name": "Peer Pod",
              "dst_pod_top_owner_kind": "Peer workload kind",
              "dst_pod_top_owner_namespace": "Peer workload namespace",
              "dst_pod_top_owner_name": "Peer workload",
              "Value #A": "Send rate",
              "Value #B": "WR rate",
              "Value #C": "Total bytes",
              "Value #D": "QPs",
              "src_device": "Local device",
              "dst_device": "Peer device"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Send rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "WR rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total bytes"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "QPs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Send rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Send rate",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Send rate per Pod of the workload",
      "description": "Total send rate of every Pod in the selected workload, to compare load between Pods.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (src_pod_namespace, src_pod_name) (\n  rate(rdma_flow_bytes_total{src_pod_top_owner_namespace=\"$namespace\", src_pod_top_owner_kind=\"$kind\", src_pod_top_owner_name=\"$workload\", src_pod_name=~\"$pod\"}[$__rate_interval])\n)",
          "legendFormat": "{{src_pod_namespace}}/{{src_pod_name}}",
          "format": "time_series",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
