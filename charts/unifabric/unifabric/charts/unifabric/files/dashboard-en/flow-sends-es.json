    {
      "id": 2,
      "type": "stat",
      "title": "Cumulative sends",
      "description": "Total submissions in the time range, the sum of count in aggregation mode.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "unifabric-elasticsearch"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "unifabric-elasticsearch"
          },
          "query": "src_pod_name:${src_pod:lucene}",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "sum",
              "field": "count"
            }
          ],
          "bucketAggs": [
            {
              "id": "2",
              "type": "terms",
              "field": "message",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "1",
                "min_doc_count": "1"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(Sum|Unique Count)$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
