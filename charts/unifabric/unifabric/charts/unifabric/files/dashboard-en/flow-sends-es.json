{
  "uid": "unifabric-flow-sends-es",
  "title": "Unifabric / RDMA Flow Sends",
  "description": "Reads the individual RDMA send records in the Elasticsearch data stream rdma-sends to show message size distribution, exact percentiles, process and QP distribution and raw records.",
  "tags": [
    "unifabric",
    "rdma",
    "ebpf",
    "flow",
    "elasticsearch",
    "events"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "src_pod",
        "label": "Source Pod",
        "type": "query",
        "datasource": {
          "type": "elasticsearch",
          "uid": "unifabric-elasticsearch"
        },
        "query": "{\"find\": \"terms\", \"field\": \"src_pod_name\", \"size\": 200}",
        "refresh": 2,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": "*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "panels": [
