    {
      "id": 14,
      "type": "timeseries",
      "title": "Resolved and unresolved sends",
      "description": "Resolved means both ends map to a Pod. Unresolved usually means the peer RDMAEndpoint is not published or a non hostNetwork Pod lacks annotations.",
      "datasource": {
        "type": "elasticsearch",
        "uid": "unifabric-elasticsearch"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "unifabric-elasticsearch"
          },
          "query": "*",
          "timeField": "@timestamp",
          "metrics": [
            {
              "id": "1",
              "type": "rate",
              "field": "count",
              "settings": {
                "unit": "second",
                "mode": "sum"
              }
            }
          ],
          "bucketAggs": [
            {
              "id": "3",
              "type": "filters",
              "settings": {
                "filters": [
                  {
                    "query": "src_pod_name:/.+/ AND dst_pod_name:/.+/",
                    "label": "resolved"
                  },
                  {
                    "query": "NOT (src_pod_name:/.+/ AND dst_pod_name:/.+/)",
                    "label": "unresolved"
                  }
                ]
              }
            },
            {
              "id": "2",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
